---
// HeaderControls Component
---
<div class="header-controls">
	<div class="toggles-group">
		<div class="control-group">
			<label class="toggle-switch">
				<input type="checkbox" id="vitals-toggle">
				<span class="slider"></span>
			</label>
			<span>Show Vitals Charts</span>
		</div>
		
		<div class="control-group">
			<label class="toggle-switch">
				<input type="checkbox" id="stats-toggle">
				<span class="slider"></span>
			</label>
			<span>Show Container Stats</span>
		</div>
	</div>

	<div class="polling-controls">
		<span id="sync-status" class="sync-status">Initializing...</span>
		<select id="refresh-interval" class="custom-select">
			<option value="5000">Every 5s</option>
			<option value="10000" selected>Every 10s</option>
			<option value="30000">Every 30s</option>
			<option value="60000">Every 60s</option>
			<option value="paused">Paused</option>
		</select>
		<button id="refresh-now-btn" class="icon-button" title="Refresh Now">
			<svg id="refresh-icon" class="refresh-icon" viewBox="0 0 24 24" width="16" height="16">
				<path d="M17.65 6.35A7.95 7.95 0 0 0 12 4a8 8 0 1 0 8 8h-2a6 6 0 1 1-6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" fill="currentColor"/>
			</svg>
		</button>
	</div>
</div>

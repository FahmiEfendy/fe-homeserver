		<script>
			// Add loading class to all sparklines initially
			document.querySelectorAll('.sparkline').forEach(el => el.classList.add('loading'));

			// Rolling telemetry history state
			const history = {
				server: {
					cpu: [],
					ram: [],
					temp: []
				},
				containers: {} // keyed by lowercase container name, e.g. "fe-homeserver": { cpu: [], mem: [] }
			};
			const MAX_HISTORY_POINTS = 30;

			// Theme Switcher Logic
			const themeToggleBtn = document.getElementById('theme-toggle-btn');
			const sunIcon = document.getElementById('theme-sun-icon');
			const moonIcon = document.getElementById('theme-moon-icon');

			function applyTheme(theme) {
				if (theme === 'light') {
					document.documentElement.classList.add('light-theme');
					if (sunIcon) sunIcon.classList.remove('hidden');
					if (moonIcon) moonIcon.classList.add('hidden');
				} else {
					document.documentElement.classList.remove('light-theme');
					if (sunIcon) sunIcon.classList.add('hidden');
					if (moonIcon) moonIcon.classList.remove('hidden');
				}
				localStorage.setItem('theme', theme);
			}

			// Detect theme preference
			const savedTheme = localStorage.getItem('theme');
			const systemPrefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
			const initialTheme = savedTheme || (systemPrefersLight ? 'light' : 'dark');
			applyTheme(initialTheme);

			if (themeToggleBtn) {
				themeToggleBtn.addEventListener('click', () => {
					const isLight = document.documentElement.classList.contains('light-theme');
					applyTheme(isLight ? 'dark' : 'light');
					drawHistoricalChart();
				});
			}

			// Render inline SVG sparkline helper
			function updateSparkline(svgElement, values, color = '#22c55e') {
				if (!svgElement || !values || values.length < 2) return;
				
				svgElement.classList.remove('loading');
				
				let min = Math.min(...values);
				let max = Math.max(...values);
				if (max - min < 1) {
					max = min + 1; // Ensure some range to avoid division by zero or flat scale
				}
				const range = max - min;
				
				const points = values.map((val, index) => {
					const x = (index / (values.length - 1)) * 100;
					const y = 22 - ((val - min) / range) * 20; // 2px margin top/bottom inside 24px height
					return { x, y };
				});
				
				const linePath = points.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ');
				const fillPath = `${linePath} L 100 24 L 0 24 Z`;
				
				// Generate unique ID for linearGradient to avoid conflicts
				const gradId = 'grad-' + Math.random().toString(36).substr(2, 9);
				
				svgElement.innerHTML = `
					<defs>
						<linearGradient id="${gradId}" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0%" stop-color="${color}" stop-opacity="0.15"/>
							<stop offset="100%" stop-color="${color}" stop-opacity="0.0"/>
						</linearGradient>
					</defs>
					<path d="${fillPath}" fill="url(#${gradId})"></path>
					<path d="${linePath}" fill="none" stroke="${color}" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
				`;
			}

			let hasApiError = false;
			let hasDockerError = false;
			let currentInterval = 10000; // default 10s
			let pollTimeoutId = null;
			let isPollingActive = true;

			async function fetchVitals() {
				const cpuLoadEl = document.getElementById('cpu-load');
				const ramUsedEl = document.getElementById('ram-used');
				const ramTotalEl = document.getElementById('ram-total');
				const diskUsageEl = document.getElementById('disk-usage');
				const tempEl = document.getElementById('temp');
				const errorBanner = document.getElementById('error-banner');

				try {
					const apiUrl = import.meta.env.PUBLIC_API_BASE_URL + '/vitals';
					const res = await fetch(apiUrl);
					if (!res.ok) {
						throw new Error(`HTTP error ${res.status}`);
					}
					const data = await res.json();
					if (data.error) {
						throw new Error(data.error);
					}

					cpuLoadEl.textContent = data.cpuLoad;
					ramUsedEl.textContent = data.ramUsed;
					ramTotalEl.textContent = data.ramTotal;
					diskUsageEl.textContent = data.disk;
					tempEl.textContent = data.temp;

					// Remove skeleton classes on success
					[cpuLoadEl, ramUsedEl, ramTotalEl, diskUsageEl, tempEl].forEach(el => {
						if (el) el.classList.remove('skeleton', 'skeleton-text');
					});

					// Update disk progress bar
					const diskPerc = parseInt(data.disk);
					const diskBarFill = document.getElementById('disk-bar-fill');
					if (!isNaN(diskPerc) && diskBarFill) {
						diskBarFill.style.width = diskPerc + '%';
					}

					// Push CPU vitals
					const cpuVal = parseFloat(data.cpuLoad);
					if (!isNaN(cpuVal)) {
						history.server.cpu.push(cpuVal);
						if (history.server.cpu.length > MAX_HISTORY_POINTS) history.server.cpu.shift();
						updateSparkline(document.getElementById('cpu-sparkline'), history.server.cpu, '#22c55e');
					}

					// Push RAM vitals
					const ramUsedVal = parseFloat(data.ramUsed);
					const ramTotalVal = parseFloat(data.ramTotal);
					if (!isNaN(ramUsedVal) && !isNaN(ramTotalVal) && ramTotalVal > 0) {
						const ramPerc = (ramUsedVal / ramTotalVal) * 100;
						history.server.ram.push(ramPerc);
						if (history.server.ram.length > MAX_HISTORY_POINTS) history.server.ram.shift();
						updateSparkline(document.getElementById('ram-sparkline'), history.server.ram, '#3b82f6');
					}

					// Push Temp vitals
					const tempVal = parseFloat(data.temp);
					if (!isNaN(tempVal)) {
						history.server.temp.push(tempVal);
						if (history.server.temp.length > MAX_HISTORY_POINTS) history.server.temp.shift();
						updateSparkline(document.getElementById('temp-sparkline'), history.server.temp, '#f97316');
					}

					hasApiError = false;
					if (errorBanner) errorBanner.classList.add('hidden');
				} catch (err) {
					console.error('Failed to fetch vitals', err);
					hasApiError = true;
					if (errorBanner) {
						errorBanner.classList.remove('hidden');
						document.getElementById('error-banner-message').textContent = '⚠️ Unable to connect to Homeserver Backend API. Retrying...';
					}
					// Add skeleton back to indicate loading/error
					[cpuLoadEl, ramUsedEl, ramTotalEl, diskUsageEl, tempEl].forEach(el => {
						if (el) {
							el.classList.add('skeleton', 'skeleton-text');
							el.textContent = '';
						}
					});
				}
			}
			
			async function fetchDockerStats() {
				const dockerAlert = document.getElementById('docker-error-alert');
				try {
					const apiUrl = import.meta.env.PUBLIC_API_BASE_URL + '/docker';
					const res = await fetch(apiUrl);
					if (!res.ok) {
						throw new Error(`HTTP error ${res.status}`);
					}
					const data = await res.json();
					
					if (data.error) {
						throw new Error(data.error);
					}
					
					// Map stats to corresponding nodes
					const statNodes = document.querySelectorAll('[data-container]');
					statNodes.forEach(node => {
						const containerMatch = node.getAttribute('data-container');
						// Find a matching docker container (try exact match first, then fallback to includes)
						const stat = data.find(s => s.Name.toLowerCase() === containerMatch.toLowerCase())
							|| data.find(s => s.Name.toLowerCase().includes(containerMatch.toLowerCase()));
						
						if (stat) {
							if(node.querySelector('.stat-cpu')) {
								const el = node.querySelector('.stat-cpu');
								el.textContent = stat.CPUPerc;
								el.classList.remove('skeleton', 'skeleton-val');
							}
							if(node.querySelector('.stat-mem')) {
								const el = node.querySelector('.stat-mem');
								el.textContent = stat.MemUsage.split(' / ')[0];
								el.classList.remove('skeleton', 'skeleton-val');
							}
							if(node.querySelector('.stat-mem-perc')) {
								const el = node.querySelector('.stat-mem-perc');
								el.textContent = stat.MemPerc || '--%';
								el.classList.remove('skeleton', 'skeleton-val');
							}
							if(node.querySelector('.stat-uptime')) {
								const el = node.querySelector('.stat-uptime');
								el.textContent = stat.Status;
								el.classList.remove('skeleton', 'skeleton-uptime');
							}

							// Update container sparkline history
							const cpuVal = parseFloat(stat.CPUPerc);
							const memVal = parseFloat(stat.MemPerc);
							const cName = stat.Name.toLowerCase();
							
							if (!history.containers[cName]) {
								history.containers[cName] = { cpu: [], mem: [] };
							}
							
							if (!isNaN(cpuVal)) {
								history.containers[cName].cpu.push(cpuVal);
								if (history.containers[cName].cpu.length > 12) history.containers[cName].cpu.shift();
								const cpuSvg = node.querySelector('.container-sparkline-cpu');
								if (cpuSvg) updateSparkline(cpuSvg, history.containers[cName].cpu, '#22c55e');
							}
							
							if (!isNaN(memVal)) {
								history.containers[cName].mem.push(memVal);
								if (history.containers[cName].mem.length > 12) history.containers[cName].mem.shift();
								const memSvg = node.querySelector('.container-sparkline-mem');
								if (memSvg) updateSparkline(memSvg, history.containers[cName].mem, '#3b82f6');
							}
						}
					});
					
					// Update dynamic health dots
					const dots = document.querySelectorAll('.status-dot[data-dot-for]');
					dots.forEach(dot => {
						const containerMatch = dot.getAttribute('data-dot-for');
						const stat = data.find(s => s.Name.toLowerCase() === containerMatch.toLowerCase())
							|| data.find(s => s.Name.toLowerCase().includes(containerMatch.toLowerCase()));
						if (stat && stat.Status.startsWith('Up')) {
							dot.style.backgroundColor = 'var(--accent-online)';
						} else {
							dot.style.backgroundColor = '#ef4444';
						}
					});

					hasDockerError = false;
					if (dockerAlert) dockerAlert.classList.add('hidden');
				} catch (err) {
					console.error('Failed to fetch docker stats', err);
					hasDockerError = true;
					if (dockerAlert) dockerAlert.classList.remove('hidden');
					
					// Set status dots to red/error
					const dots = document.querySelectorAll('.status-dot[data-dot-for]');
					dots.forEach(dot => {
						dot.style.backgroundColor = '#ef4444';
					});

					// Reset container stats to error/loading
					const statNodes = document.querySelectorAll('[data-container]');
					statNodes.forEach(node => {
						if(node.querySelector('.stat-cpu')) node.querySelector('.stat-cpu').textContent = '--%';
						if(node.querySelector('.stat-mem')) node.querySelector('.stat-mem').textContent = '--';
						if(node.querySelector('.stat-mem-perc')) node.querySelector('.stat-mem-perc').textContent = '--%';
						if(node.querySelector('.stat-uptime')) node.querySelector('.stat-uptime').textContent = 'Unreachable';
					});
				}
			}

			// Historical Analytics Graph Logic
			let activeTab = 'cpu';
			const analyticsTabs = document.querySelectorAll('.analytics-tab');

			analyticsTabs.forEach(tab => {
				tab.addEventListener('click', (e) => {
					analyticsTabs.forEach(t => t.classList.remove('active'));
					e.target.classList.add('active');
					activeTab = e.target.getAttribute('data-tab');
					drawHistoricalChart();
				});
			});

			function drawHistoricalChart() {
				const svg = document.getElementById('history-chart-svg');
				const areaPath = document.getElementById('chart-area-path');
				const linePath = document.getElementById('chart-line-path');
				const scaleMax = document.getElementById('scale-max');
				const scaleMid = document.getElementById('scale-mid');
				const scaleMin = document.getElementById('scale-min');

				if (!svg || !areaPath || !linePath) return;

				const values = history.server[activeTab] || [];
				const placeholder = document.getElementById('chart-loading-placeholder');
				if (values.length < 2) {
					if (placeholder) placeholder.classList.remove('hidden');
					areaPath.setAttribute('d', '');
					linePath.setAttribute('d', '');
					return;
				} else {
					if (placeholder) placeholder.classList.add('hidden');
				}

				// Determine limits based on tab
				let minVal = 0;
				let maxVal = 100;

				if (activeTab === 'cpu') {
					maxVal = 100;
					scaleMax.textContent = '100%';
					scaleMid.textContent = '50%';
					scaleMin.textContent = '0%';
				} else if (activeTab === 'ram') {
					maxVal = 100;
					scaleMax.textContent = '100%';
					scaleMid.textContent = '50%';
					scaleMin.textContent = '0%';
				} else if (activeTab === 'temp') {
					const maxTemp = Math.max(...values, 80);
					maxVal = Math.ceil(maxTemp / 10) * 10;
					scaleMax.textContent = `${maxVal}°C`;
					scaleMid.textContent = `${(maxVal/2).toFixed(0)}°C`;
					scaleMin.textContent = '0°C';
				}

				const range = maxVal - minVal;
				const width = 500;
				const height = 150;

				// Generate points mapping (plotted between y = 20 and y = 140 inside 150px viewport height)
				const points = values.map((val, index) => {
					const x = (index / (values.length - 1)) * width;
					const y = height - ((val - minVal) / range) * 120 - 10;
					return { x, y };
				});

				// Construct bezier curve path string
				let linePathStr = '';
				points.forEach((p, i) => {
					if (i === 0) {
						linePathStr = `M ${p.x.toFixed(1)} ${p.y.toFixed(1)}`;
					} else {
						const prev = points[i - 1];
						const cpX1 = prev.x + (p.x - prev.x) / 3;
						const cpY1 = prev.y;
						const cpX2 = prev.x + 2 * (p.x - prev.x) / 3;
						const cpY2 = p.y;
						linePathStr += ` C ${cpX1.toFixed(1)} ${cpY1.toFixed(1)}, ${cpX2.toFixed(1)} ${cpY2.toFixed(1)}, ${p.x.toFixed(1)} ${p.y.toFixed(1)}`;
					}
				});

				const areaPathStr = `${linePathStr} L ${points[points.length - 1].x.toFixed(1)} ${height} L ${points[0].x.toFixed(1)} ${height} Z`;

				// Set paths and colors
				let color = 'var(--accent-online)'; // CPU
				if (activeTab === 'ram') color = 'var(--accent-blue)';
				if (activeTab === 'temp') color = 'var(--accent-orange)';

				// Create gradient background
				const gradId = `analytics-grad-${activeTab}`;
				const isLight = document.documentElement.classList.contains('light-theme');
				const opacityStart = isLight ? '0.12' : '0.2';
				
				svg.querySelector('defs')?.remove(); // Clear existing definitions
				const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
				defs.innerHTML = `
					<linearGradient id="${gradId}" x1="0" y1="0" x2="0" y2="1">
						<stop offset="0%" stop-color="${color}" stop-opacity="${opacityStart}"/>
						<stop offset="100%" stop-color="${color}" stop-opacity="0.0"/>
					</linearGradient>
				`;
				svg.insertBefore(defs, svg.firstChild);

				areaPath.setAttribute('d', areaPathStr);
				areaPath.setAttribute('fill', `url(#${gradId})`);
				
				linePath.setAttribute('d', linePathStr);
				linePath.setAttribute('stroke', color);
			}

			async function updateData() {
				const refreshIcon = document.getElementById('refresh-icon');
				if (refreshIcon) refreshIcon.classList.add('spinning');
				
				const statusText = document.getElementById('sync-status');
				if (statusText) statusText.textContent = 'Syncing...';

				const vitalsPromise = fetchVitals();
				const dockerPromise = fetchDockerStats();

				await Promise.allSettled([vitalsPromise, dockerPromise]);

				if (refreshIcon) {
					setTimeout(() => refreshIcon.classList.remove('spinning'), 500);
				}
				
				const nowStr = new Date().toLocaleTimeString();
				if (statusText) {
					if (hasApiError || hasDockerError) {
						statusText.textContent = `Sync error at ${nowStr}`;
						statusText.style.color = '#ef4444';
					} else {
						statusText.textContent = `Synced at ${nowStr}`;
						statusText.style.color = 'var(--text-muted)';
					}
				}

				drawHistoricalChart();

				if (isPollingActive) {
					schedulePoll();
				}
			}

			function schedulePoll() {
				if (pollTimeoutId) clearTimeout(pollTimeoutId);
				if (currentInterval === 'paused') {
					isPollingActive = false;
					const statusText = document.getElementById('sync-status');
					if (statusText) {
						statusText.textContent = 'Polling paused';
						statusText.style.color = 'var(--text-muted)';
					}
					return;
				}
				isPollingActive = true;
				pollTimeoutId = setTimeout(updateData, currentInterval);
			}
			
			// Handle Toggles
			const toggle = document.getElementById('stats-toggle');
			toggle.addEventListener('change', (e) => {
				const statsBlocks = document.querySelectorAll('.card-stats');
				statsBlocks.forEach(block => {
					if (e.target.checked) {
						block.classList.add('visible');
					} else {
						block.classList.remove('visible');
					}
				});
			});

			const vitalsToggle = document.getElementById('vitals-toggle');
			vitalsToggle.addEventListener('change', (e) => {
				const vitalsBar = document.getElementById('vitals-bar');
				const historyCard = document.getElementById('history-analytics');
				if (e.target.checked) {
					vitalsBar.classList.add('show-charts');
					if (historyCard) {
						historyCard.classList.remove('hidden');
						drawHistoricalChart();
					}
				} else {
					vitalsBar.classList.remove('show-charts');
					if (historyCard) historyCard.classList.add('hidden');
				}
			});

			// Polling selection handler
			const intervalSelect = document.getElementById('refresh-interval');
			if (intervalSelect) {
				intervalSelect.addEventListener('change', (e) => {
					const val = e.target.value;
					if (val === 'paused') {
						currentInterval = 'paused';
					} else {
						currentInterval = parseInt(val);
					}
					schedulePoll();
				});
			}

			// Manual refresh button listener
			const refreshBtn = document.getElementById('refresh-now-btn');
			if (refreshBtn) {
				refreshBtn.addEventListener('click', () => {
					if (pollTimeoutId) clearTimeout(pollTimeoutId);
					updateData();
				});
			}
			
			// Initial startup
			updateData();
		</script>
	</body>
</html>

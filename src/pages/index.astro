---
const baseDomain = import.meta.env.BASE_DOMAIN || 'fahmiefendy.dev';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>fahmi homeserver.</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<style>
			:root {
				--bg-color: #121212;
				--card-bg: #1a1a1a;
				--text-main: #f0f0f0;
				--text-muted: #888888;
				--border-color: #2a2a2a;
				--border-hover: #555;
				--select-bg: #222;
				--dot-offline: #444;
				--accent-online: #22c55e;
				--accent-blue: #3b82f6;
				--accent-purple: #a855f7;
				--accent-orange: #f97316;
				--chart-grid: rgba(255, 255, 255, 0.05);
				--alert-error-bg: rgba(239, 68, 68, 0.1);
				--alert-error-border: rgba(239, 68, 68, 0.2);
				--alert-error-text: #fca5a5;
				--alert-warning-bg: rgba(245, 158, 11, 0.08);
				--alert-warning-border: rgba(245, 158, 11, 0.15);
				--alert-warning-text: #fde047;
				--skeleton-bg: linear-gradient(90deg, rgba(255, 255, 255, 0.03) 25%, rgba(255, 255, 255, 0.08) 50%, rgba(255, 255, 255, 0.03) 75%);
				--disk-bg: rgba(255, 255, 255, 0.1);
				--vital-bg: rgba(255, 255, 255, 0.02);
			}
			:root.light-theme {
				--bg-color: #f4f4f6;
				--card-bg: #ffffff;
				--text-main: #1d1d1f;
				--text-muted: #6e6e73;
				--border-color: #e5e5ea;
				--border-hover: #b0b0b5;
				--select-bg: #ffffff;
				--dot-offline: #c7c7cc;
				--chart-grid: rgba(0, 0, 0, 0.05);
				--alert-error-bg: rgba(239, 68, 68, 0.08);
				--alert-error-border: rgba(239, 68, 68, 0.25);
				--alert-error-text: #b91c1c;
				--alert-warning-bg: rgba(245, 158, 11, 0.06);
				--alert-warning-border: rgba(245, 158, 11, 0.3);
				--alert-warning-text: #b45309;
				--skeleton-bg: linear-gradient(90deg, rgba(0, 0, 0, 0.05) 25%, rgba(0, 0, 0, 0.1) 50%, rgba(0, 0, 0, 0.05) 75%);
				--disk-bg: rgba(0, 0, 0, 0.08);
				--vital-bg: rgba(0, 0, 0, 0.015);
			}
			body {
				background-color: var(--bg-color);
				color: var(--text-main);
				font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
				margin: 0;
				padding: 60px 20px;
				display: flex;
				justify-content: center;
			}
			.container {
				max-width: 800px;
				width: 100%;
			}
			.header-row {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 1rem;
			}
			h1 {
				font-size: 1.5rem;
				font-weight: 600;
				margin: 0;
				letter-spacing: -0.02em;
			}
			.header-controls {
				display: flex;
				justify-content: space-between;
				align-items: center;
				flex-wrap: wrap;
				gap: 16px;
				margin-bottom: 2rem;
				background-color: var(--card-bg);
				border: 1px solid var(--border-color);
				padding: 12px 16px;
				border-radius: 6px;
			}
			.toggles-group {
				display: flex;
				gap: 24px;
				align-items: center;
			}
			.control-group {
				display: flex;
				align-items: center;
				gap: 8px;
				font-size: 0.85rem;
				color: var(--text-muted);
			}
			.polling-controls {
				display: flex;
				align-items: center;
				gap: 12px;
				margin-left: auto;
			}
			.sync-status {
				font-size: 0.8rem;
				color: var(--text-muted);
				font-family: monospace;
			}
			.custom-select {
				appearance: none;
				-webkit-appearance: none;
				-moz-appearance: none;
				background-color: var(--select-bg);
				color: var(--text-main);
				border: 1px solid var(--border-color);
				border-radius: 4px;
				padding: 4px 28px 4px 10px;
				font-size: 0.8rem;
				outline: none;
				cursor: pointer;
				transition: border-color 0.2s;
				background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23888888' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
				background-repeat: no-repeat;
				background-position: right 8px center;
				background-size: 12px;
				min-width: 105px;
			}
			.custom-select option {
				background-color: var(--card-bg);
				color: var(--text-main);
			}
			.custom-select:hover {
				border-color: var(--border-hover);
			}
			.icon-button {
				background: none;
				border: 1px solid var(--border-color);
				border-radius: 4px;
				color: var(--text-muted);
				cursor: pointer;
				padding: 4px;
				display: flex;
				align-items: center;
				justify-content: center;
				transition: all 0.2s;
			}
			.icon-button:hover {
				border-color: var(--border-hover);
				color: var(--text-main);
				background-color: rgba(255, 255, 255, 0.05);
			}
			.icon-button:active {
				transform: scale(0.95);
			}
			.refresh-icon {
				transition: transform 0.3s ease;
			}
			.refresh-icon.spinning {
				animation: spin 0.8s linear infinite;
			}
			@keyframes spin {
				0% { transform: rotate(0deg); }
				100% { transform: rotate(360deg); }
			}

			/* Error States */
			.error-banner {
				display: flex;
				align-items: center;
				gap: 10px;
				background-color: var(--alert-error-bg);
				border: 1px solid var(--alert-error-border);
				color: var(--alert-error-text);
				border-radius: 6px;
				padding: 12px 16px;
				margin-bottom: 1.5rem;
				font-size: 0.85rem;
				backdrop-filter: blur(8px);
				animation: fadeIn 0.3s ease;
			}
			.docker-error-alert {
				display: flex;
				align-items: flex-start;
				gap: 12px;
				background-color: var(--alert-warning-bg);
				border: 1px solid var(--alert-warning-border);
				color: var(--alert-warning-text);
				border-radius: 6px;
				padding: 14px 16px;
				margin-bottom: 2rem;
				font-size: 0.85rem;
				backdrop-filter: blur(8px);
				animation: fadeIn 0.3s ease;
			}
			.alert-content {
				display: flex;
				flex-direction: column;
				gap: 4px;
			}
			.alert-title {
				font-weight: 600;
			}
			.alert-desc {
				margin: 0;
				opacity: 0.85;
				font-size: 0.8rem;
			}
			.hidden {
				display: none !important;
			}
			@keyframes fadeIn {
				from { opacity: 0; transform: translateY(-5px); }
				to { opacity: 1; transform: translateY(0); }
			}
			.section-title {
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				color: var(--text-muted);
				margin-bottom: 1rem;
				margin-top: 2.5rem;
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 16px;
			}
			.card {
				background-color: var(--card-bg);
				border: 1px solid var(--border-color);
				border-radius: 6px;
				padding: 20px;
				text-decoration: none;
				color: inherit;
				display: flex;
				flex-direction: column;
				transition: border-color 0.2s ease;
			}
			.card:hover {
				border-color: var(--border-hover);
			}
			.card-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 6px;
			}
			.card-title {
				font-size: 0.95rem;
				font-weight: 500;
				margin: 0;
			}
			.status-dots {
				display: flex;
				gap: 8px;
			}
			.dot-wrapper {
				display: flex;
				align-items: center;
				gap: 4px;
			}
			.dot-label {
				font-size: 0.65rem;
				color: var(--text-muted);
				font-family: monospace;
			}
			.status-dot {
				width: 8px;
				height: 8px;
				background-color: var(--dot-offline); /* Default offline/unknown gray */
				border-radius: 50%;
				transition: background-color 0.3s ease;
			}
			.card-desc {
				font-size: 0.85rem;
				color: var(--text-muted);
				margin: 0;
			}
			
			.vitals-bar {
				display: flex;
				gap: 20px;
				margin-bottom: 2rem;
				font-size: 0.85rem;
				color: var(--text-muted);
				background-color: var(--card-bg);
				padding: 12px 16px;
				border-radius: 6px;
				border: 1px solid var(--border-color);
				flex-wrap: wrap;
				align-items: center;
				transition: all 0.3s ease;
			}
			.vitals-bar.show-charts {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 16px;
				align-items: stretch;
				padding: 16px;
			}
			.vital {
				display: flex;
				align-items: center;
				gap: 6px;
				transition: all 0.3s ease;
				width: auto;
				box-sizing: border-box;
			}
			.vitals-bar.show-charts .vital {
				flex-direction: column;
				align-items: flex-start;
				gap: 8px;
				background-color: var(--vital-bg);
				border: 1px solid var(--border-color);
				border-radius: 6px;
				padding: 16px;
				width: 100%;
			}
			.vital div {
				white-space: nowrap;
			}
			.vital span {
				color: var(--text-main);
				font-family: monospace;
				font-size: 0.9rem;
				font-weight: 500;
			}
			.sparkline {
				display: inline-block;
				vertical-align: middle;
			}
			.sparkline.loading {
				background: var(--skeleton-bg);
				background-size: 200% 100%;
				animation: shimmer 1.5s infinite linear;
				border-radius: 4px;
			}
			@keyframes shimmer {
				0% {
					background-position: 200% 0;
				}
				100% {
					background-position: -200% 0;
				}
			}
			.vitals-bar .sparkline {
				width: 48px;
				height: 16px;
				display: none; /* Hidden by default */
			}
			.vitals-bar.show-charts .sparkline {
				display: block;
				width: 100%;
				height: 40px;
				margin-top: 8px;
			}
			.disk-bar-container {
				width: 100%;
				height: 6px;
				background-color: var(--disk-bg);
				border-radius: 3px;
				overflow: hidden;
				display: none;
				margin-top: 25px;
			}
			.vitals-bar.show-charts .disk-bar-container {
				display: block;
			}
			.disk-bar-fill {
				height: 100%;
				width: 0%;
				background-color: #a855f7;
				border-radius: 3px;
				transition: width 0.3s ease;
			}
			
			/* Skeletons */
			.skeleton {
				background: var(--skeleton-bg);
				background-size: 200% 100%;
				animation: shimmer 1.5s infinite linear;
				border-radius: 4px;
				display: inline-block;
				color: transparent !important;
			}
			.skeleton-text {
				width: 36px;
				height: 14px;
				vertical-align: middle;
			}
			.skeleton-val {
				width: 40px;
				height: 14px;
				display: inline-block;
			}
			.skeleton-uptime {
				width: 120px;
				height: 14px;
				display: inline-block;
			}
			.vital .skeleton-text {
				width: 50px;
				height: 16px;
			}
			.toggle-switch {
				position: relative;
				display: inline-block;
				width: 40px;
				height: 20px;
			}
			.toggle-switch input {
				opacity: 0;
				width: 0;
				height: 0;
			}
			.slider {
				position: absolute;
				cursor: pointer;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				background-color: var(--border-color);
				transition: .2s;
				border-radius: 20px;
			}
			.slider:before {
				position: absolute;
				content: "";
				height: 14px;
				width: 14px;
				left: 3px;
				bottom: 3px;
				background-color: var(--text-muted);
				transition: .2s;
				border-radius: 50%;
			}
			input:checked + .slider {
				background-color: var(--accent-online);
			}
			input:checked + .slider:before {
				transform: translateX(20px);
				background-color: #fff;
			}
			
			.card-stats {
				max-height: 0;
				opacity: 0;
				overflow: hidden;
				transition: max-height 0.3s ease, opacity 0.3s ease, margin-top 0.3s ease, padding-top 0.3s ease;
				margin-top: 0;
				padding-top: 0;
				border-top: 1px solid transparent;
				font-size: 0.8rem;
				color: var(--text-muted);
				font-family: monospace;
				display: flex;
				flex-direction: column;
				gap: 10px;
			}
			.card-stats.visible {
				max-height: 200px;
				opacity: 1;
				margin-top: 15px;
				padding-top: 15px;
				border-top-color: var(--border-color);
			}
			.stats-row {
				display: flex;
				justify-content: space-between;
				width: 100%;
				align-items: flex-start;
				gap: 12px;
			}
			.card-stats-col {
				display: flex;
				flex-direction: column;
				gap: 4px;
				align-items: flex-start;
				flex: 1;
				min-width: 0;
			}
			.card-stats-col .sparkline {
				width: 100%;
				max-width: 80px;
				height: 18px;
				margin-top: 2px;
			}
			.card-stats-label {
				font-size: 0.65rem;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				opacity: 0.7;
			}
			.card-stats-val {
				color: var(--text-main);
			}
			/* Mobile Responsiveness */
			@media (max-width: 600px) {
				body {
					padding: 30px 16px;
				}
				.grid {
					grid-template-columns: 1fr;
					gap: 12px;
				}
				h1 {
					font-size: 1.3rem;
					margin-bottom: 1rem;
				}
				.header-controls {
					flex-direction: column;
					align-items: stretch;
					gap: 12px;
				}
				.toggles-group {
					flex-direction: column;
					align-items: stretch;
					gap: 12px;
				}
				.control-group {
					justify-content: flex-start;
				}
				.polling-controls {
					margin-left: 0;
					justify-content: space-between;
					border-top: 1px solid var(--border-color);
					padding-top: 12px;
					width: 100%;
				}
				.vitals-bar.show-charts {
					grid-template-columns: repeat(2, 1fr);
					gap: 12px;
					padding: 12px;
				}
				.vitals-bar.show-charts .vital {
					padding: 12px;
				}
				.disk-bar-container {
					margin-top: 25px;
				}
				.section-title {
					margin-top: 2rem;
				}
			}

			/* Historical Analytics Section */
			.history-analytics-card {
				background-color: var(--card-bg);
				border: 1px solid var(--border-color);
				border-radius: 6px;
				padding: 20px;
				margin-bottom: 2rem;
				display: flex;
				flex-direction: column;
				gap: 16px;
				animation: fadeIn 0.3s ease;
			}
			.analytics-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				border-bottom: 1px solid var(--border-color);
				padding-bottom: 12px;
				flex-wrap: wrap;
				gap: 12px;
			}
			.analytics-tabs {
				display: flex;
				gap: 8px;
			}
			.analytics-tab {
				background: none;
				border: 1px solid var(--border-color);
				color: var(--text-muted);
				border-radius: 4px;
				padding: 6px 12px;
				font-size: 0.8rem;
				cursor: pointer;
				transition: all 0.2s;
			}
			.analytics-tab:hover {
				color: var(--text-main);
				border-color: var(--border-hover);
			}
			.analytics-tab.active {
				color: #fff;
				background-color: var(--accent-blue);
				border-color: var(--accent-blue);
			}
			.analytics-tab.active[data-tab="cpu"] {
				background-color: var(--accent-online);
				border-color: var(--accent-online);
			}
			.analytics-tab.active[data-tab="ram"] {
				background-color: var(--accent-blue);
				border-color: var(--accent-blue);
			}
			.analytics-tab.active[data-tab="temp"] {
				background-color: var(--accent-orange);
				border-color: var(--accent-orange);
			}

			.chart-container {
				display: flex;
				gap: 16px;
				align-items: stretch;
				padding-top: 10px;
			}
			.chart-y-axis {
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				font-size: 0.7rem;
				color: var(--text-muted);
				font-family: monospace;
				text-align: right;
				width: 35px;
				user-select: none;
				padding-top: 12px;
				padding-bottom: 5px;
				box-sizing: border-box;
			}
			.chart-placeholder {
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				display: flex;
				align-items: center;
				justify-content: center;
				border-radius: 6px;
				font-size: 0.85rem;
				color: var(--text-muted);
				font-family: monospace;
				z-index: 5;
				pointer-events: none;
				transition: opacity 0.3s ease;
			}
			@media (max-width: 480px) {
				.stats-row {
					display: grid;
					grid-template-columns: repeat(2, 1fr);
					gap: 12px 8px;
				}
			}
		</style>
	</head>
	<body>
		<div class="container">
			<div class="header-row">
				<h1>fahmi homeserver.</h1>
				<button id="theme-toggle-btn" class="icon-button" title="Toggle Theme">
					<!-- Sun icon (for light mode) -->
					<svg id="theme-sun-icon" class="theme-icon hidden" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
						<circle cx="12" cy="12" r="5"></circle>
						<line x1="12" y1="1" x2="12" y2="3"></line>
						<line x1="12" y1="21" x2="12" y2="23"></line>
						<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
						<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
						<line x1="1" y1="12" x2="3" y2="12"></line>
						<line x1="21" y1="12" x2="23" y2="12"></line>
						<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
						<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
					</svg>
					<!-- Moon icon (for dark mode) -->
					<svg id="theme-moon-icon" class="theme-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
					</svg>
				</button>
			</div>

			<!-- Error Banner for general API unreachable status -->
			<div id="error-banner" class="error-banner hidden">
				<span class="error-banner-icon">⚠️</span>
				<span id="error-banner-message">Unable to connect to homeserver backend.</span>
			</div>

			<div class="header-controls">
				<div class="toggles-group">
					<div class="control-group">
						<label class="toggle-switch">
							<input type="checkbox" id="vitals-toggle">
							<span class="slider"></span>
						</label>
						<span>Show Vitals Charts</span>
					</div>
					
					<div class="control-group">
						<label class="toggle-switch">
							<input type="checkbox" id="stats-toggle">
							<span class="slider"></span>
						</label>
						<span>Show Container Stats</span>
					</div>
				</div>

				<div class="polling-controls">
					<span id="sync-status" class="sync-status">Initializing...</span>
					<select id="refresh-interval" class="custom-select">
						<option value="5000">Every 5s</option>
						<option value="10000" selected>Every 10s</option>
						<option value="30000">Every 30s</option>
						<option value="60000">Every 60s</option>
						<option value="paused">Paused</option>
					</select>
					<button id="refresh-now-btn" class="icon-button" title="Refresh Now">
						<svg id="refresh-icon" class="refresh-icon" viewBox="0 0 24 24" width="16" height="16">
